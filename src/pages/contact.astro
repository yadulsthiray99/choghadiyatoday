import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
---
<Base title="Contact | ChoghadiyaToday" description="How to contact ChoghadiyaToday about a choghadiya time, a missing city or a correction.">
  <h1>Contact</h1>
  <p>Spotted a time that looks wrong, or want your city added? Email <strong>hello at choghadiyatoday dot in</strong>. Please include the city and date.</p>
  <p>For ceremonies, please confirm the muhurat with your family priest.</p>
  <p>Questions, corrections, advertising or partnership ideas are all welcome. Send a message below and it comes straight to our inbox; we usually reply within 2 working days.</p>
  <ContactForm />
</Base>
